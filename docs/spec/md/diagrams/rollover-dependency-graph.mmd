  %% ===== Filler → Settler =====
  BaseFiller --> Settler
  %% EvcRolloverAdapter is adapter/integration context only and out of audit scope
  %% unless explicitly re-added in SCOPE.md.
  EvcAdapter -.->|"adapter context"| Settler
  EvcAdapter ...> IEVC

  %% ===== Filler imports =====
  BaseFiller --> RolloverTypes
  BaseFiller --> LibRolloverOrder
  BaseFiller --> LibSettlerHashing
  BaseFiller --> ISettler
  BaseFiller --> OZ_SafeERC20
  BaseFiller -.-> OZ_Init

  EvcAdapter --> RolloverTypes
  EvcAdapter --> ISettler
  EvcAdapter --> OZ_SafeERC20
  EvcAdapter -.-> OZ_Init

  %% ===== Settler imports / inherits =====
  Settler --> RolloverTypes
  Settler --> Factory
  Settler --> LibSettlerHashing
  Settler --> LibRolloverOrder
  Settler --> LibHookPhase
  Settler --> LibFillerAuth
  Settler --> Typehashes
  Settler --> ISettler
  Settler --> IFactory
  Settler ...> IPoolShare
  Settler ...> IOriginSettler
  Settler --> OZ_SafeERC20
  Settler -.-> OZ_Access
  Settler -.-> OZ_Init

  %% ===== Factory =====
  Factory --> RolloverTypes
  Factory --> IRolloverContract
  Factory --> IFactory
  Factory --> ILens
  Factory -.-> OZ_Access
  Factory -.-> OZ_Init

  %% ===== RolloverContract =====
  RolloverContract --> RolloverTypes
  RolloverContract --> LibAuthHooks
  RolloverContract --> Typehashes
  RolloverContract --> IRolloverContract
  RolloverContract --> IFactory
  RolloverContract --> IERC7484s
  RolloverContract ...> IERC7484x
  RolloverContract ...> IPoolShare
  RolloverContract ...> IPoolMgr
  RolloverContract -.-> OZ_Init
  RolloverContract --> OZ_SafeERC20
  RolloverContract ==> MODULES

  %% ===== Libraries internal =====
  LibSettlerHashing --> RolloverTypes
  LibSettlerHashing --> Typehashes
  LibAuthHooks --> RolloverTypes
  LibAuthHooks --> Typehashes
  LibRolloverOrder --> RolloverTypes
  LibHookPhase --> RolloverTypes
  LibFillerAuth --> Typehashes
  Typehashes ...> IERC7484x

  %% ===== Modules internal =====
  Approve --> OnlyDelegate
  Split --> OnlyDelegate
  ScopedSplit --> OnlyDelegate
  ScopedTransfer --> OnlyDelegate
  PreRef --> OnlyDelegate
  MidRef --> OnlyDelegate
  PostRef --> OnlyDelegate
  Approve --> OZ_SafeERC20
  Split --> OZ_SafeERC20
  ScopedSplit --> OZ_SafeERC20
  ScopedTransfer --> OZ_SafeERC20

